# ── LOCAL AI CONFIGURATION ──
# Primary LLM config (vLLM, llama.cpp, etc.)
LLM_HOST="http://127.0.0.1:8000"
LLM_MODEL="qwen3-8b"
LLM_API_KEY="not-needed-for-local"

# Fallback (Ollama backward compatibility)
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:8b"
STT_PORT=5050
# Primary: NeMo IndicConformer model path (downloads on first run to NEMO_CACHE_DIR)
NEMO_MODEL="ai4bharat/indicConformer-multilingual"
NEMO_CACHE_DIR="D:/invoice/models/nemo"
# Fallback: faster-whisper model (used if NeMo fails to load)
WHISPER_MODEL="D:/invoice/models/large-v3-turbo"
STT_COMPUTE_TYPE="int8"
PYTHON_CMD="" # Optional: specific python executable to run the STT sidecar
STT_BACKEND="auto"   # auto | nemo | whisper-live

# ==========================================
# 4. Cloud Fallback (Optional)
# ==========================================
# Set this to enable Groq as a fast cloud fallback when Ollama is offline.
# Requires explicit user consent in the UI before activating.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"

# ── SERVER CONFIGURATION ──
PORT=3000
NODE_ENV="development"
API_SECRET=""
ALLOWED_ORIGINS="http://localhost:3000"

# ── AUTHENTICATION ──
JWT_SECRET="your-secure-secret-here"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

VITE_SUPABASE_URL=
