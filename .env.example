# ── SERVER CONFIGURATION ──
PORT=3000
NODE_ENV="development"

# ── LOCAL LLM CONFIGURATION (Ollama / vLLM / llama.cpp) ──
LLM_HOST="http://127.0.0.1:11434"
LLM_MODEL="invoice-qwen2.5-1.5b-q8_0"
LLM_API_KEY="not-needed-for-local"

# ── STT CONFIGURATION (Speech-to-Text Sidecar) ──
STT_PORT=5050
WHISPER_MODEL="models/large-v3-turbo"
PYTHON_CMD="" # Optional: path to python binary for stt_server.py
