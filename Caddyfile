{
    # Global options
    auto_https disable_redirects
}

# When DOMAIN is set, Caddy will obtain Let's Encrypt TLS certificates.
# Default to :80 / internal TLS for local testing.
{$DOMAIN::80} {
    encode gzip zstd

    reverse_proxy app:8000 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }
}
