  "components": {
    "schemas": {
      "BusinessProfileUpdate": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "address_lines": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "maxItems": 4
              },
              {
                "type": "null"
              }
            ],
            "title": "Address Lines"
          },
          "phones": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "maxItems": 3
              },
              {
                "type": "null"
              }
            ],
            "title": "Phones"
          },
          "footer": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Footer"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 10
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "date_format": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Date Format"
          },
          "help_improve_voice": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Help Improve Voice"
          },
          "default_preset_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Preset Id"
          },
          "pin": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50,
                "minLength": 4
              },
              {
                "type": "null"
              }
            ],
            "title": "Pin"
          }
        },
        "type": "object",
        "title": "BusinessProfileUpdate"
      },
      "ColumnRegistryItem": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "title": "Id"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "title": "Label"
          },
          "kind": {
            "type": "string",
            "enum": [
              "serial",
              "text",
              "number",
              "money",
              "percent"
            ],
            "title": "Kind"
          },
          "filled_by": {
            "type": "string",
            "enum": [
              "auto",
              "voice",
              "computed"
            ],
            "title": "Filled By"
          },
          "width": {
            "type": "string",
            "title": "Width"
          },
          "align": {
            "type": "string",
            "enum": [
              "left",
              "center",
              "right"
            ],
            "title": "Align"
          },
          "version1": {
            "type": "boolean",
            "title": "Version1"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "kind",
          "filled_by",
          "width",
          "align",
          "version1"
        ],
        "title": "ColumnRegistryItem"
      },
      "DesignItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "sample_preview_url": {
            "type": "string",
            "title": "Sample Preview Url"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "sample_preview_url"
        ],
        "title": "DesignItem"
      },
      "FirstRunSetupRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "address_lines": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 4,
            "title": "Address Lines"
          },
          "phones": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Phones"
          },
          "footer": {
            "type": "string",
            "maxLength": 500,
            "title": "Footer",
            "default": ""
          },
          "currency": {
            "type": "string",
            "maxLength": 10,
            "title": "Currency",
            "default": "\u20b9"
          },
          "date_format": {
            "type": "string",
            "maxLength": 50,
            "title": "Date Format",
            "default": "DD MMMM YYYY"
          },
          "design_id": {
            "type": "string",
            "minLength": 1,
            "title": "Design Id",
            "default": "design1"
          },
          "columns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Columns",
            "default": [
              "no",
              "item",
              "qty",
              "rate",
              "amount"
            ]
          },
          "pin": {
            "type": "string",
            "maxLength": 50,
            "minLength": 4,
            "title": "Pin"
          },
          "help_improve_voice": {
            "type": "boolean",
            "title": "Help Improve Voice",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "name",
          "pin"
        ],
        "title": "FirstRunSetupRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "pin": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Pin"
          }
        },
        "type": "object",
        "required": [
          "pin"
        ],
        "title": "LoginRequest"
      },
      "MeResponse": {
        "properties": {
          "workspace_id": {
            "type": "string",
            "title": "Workspace Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "workspace_id",
          "name"
        ],
        "title": "MeResponse"
      },
      "PresetCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "default": "Default"
          },
          "design_id": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Design Id",
            "default": "design1"
          },
          "columns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Columns",
            "description": "Ordered column IDs",
            "default": [
              "no",
              "item",
              "qty",
              "rate",
              "amount"
            ]
          },
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Labels",
            "description": "Overrides for billed_to, date, total"
          }
        },
        "type": "object",
        "title": "PresetCreate"
      },
      "PresetModel": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "default": "Default"
          },
          "design_id": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Design Id",
            "default": "design1"
          },
          "columns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Columns",
            "description": "Ordered column IDs",
            "default": [
              "no",
              "item",
              "qty",
              "rate",
              "amount"
            ]
          },
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Labels",
            "description": "Overrides for billed_to, date, total"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "workspace_id": {
            "type": "string",
            "title": "Workspace Id"
          },
          "archived": {
            "type": "boolean",
            "title": "Archived",
            "default": false
          },
          "created_at": {
